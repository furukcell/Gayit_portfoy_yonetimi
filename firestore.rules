rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSuperadmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/superadmins/$(request.auth.uid))
        && get(/databases/$(database)/documents/superadmins/$(request.auth.uid)).data.enabled == true;
    }
    function activeMembership(officeId) {
      return signedIn()
        && exists(/databases/$(database)/documents/office_members/$(request.auth.uid))
        && get(/databases/$(database)/documents/office_members/$(request.auth.uid)).data.office_id == officeId
        && get(/databases/$(database)/documents/office_members/$(request.auth.uid)).data.status == 'active';
    }
    function isOwner(officeId) {
      return activeMembership(officeId)
        && get(/databases/$(database)/documents/office_members/$(request.auth.uid)).data.role == 'owner';
    }
    match /superadmins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /profiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuperadmin() || (resource.data.office_id is string && activeMembership(resource.data.office_id)));
      allow create: if (signedIn() && request.auth.uid == uid
          && !request.resource.data.keys().hasAny(['role', 'isSuperadmin', 'office_id']))
        || (isSuperadmin()
          && request.resource.data.keys().hasOnly(['username','full_name','office_id','avatar_path','account_status','must_change_password','created_at'])
          && request.resource.data.office_id is string
          && request.resource.data.account_status == 'active')
        || (signedIn()
          && request.resource.data.keys().hasOnly(['username','full_name','office_id','avatar_path','account_status','must_change_password','created_at'])
          && request.resource.data.office_id is string
          && request.resource.data.account_status == 'active'
          && request.resource.data.must_change_password == true
          && isOwner(request.resource.data.office_id));
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['full_name', 'avatar_path', 'phone', 'email', 'updated_at', 'must_change_password']);
      allow delete: if false;
    }
    match /office_members/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuperadmin() || activeMembership(resource.data.office_id));
      allow create: if (isSuperadmin()
          && request.resource.data.keys().hasOnly(['office_id','role','status','created_at','created_by'])
          && request.resource.data.office_id is string
          && request.resource.data.role in ['owner','agent']
          && request.resource.data.status == 'active')
        || (signedIn()
          && request.resource.data.keys().hasOnly(['office_id','role','status','created_at','created_by'])
          && request.resource.data.office_id is string
          && request.resource.data.role == 'agent'
          && request.resource.data.status == 'active'
          && request.resource.data.created_by == request.auth.uid
          && isOwner(request.resource.data.office_id));
      allow update, delete: if false;
    }
    match /offices/{officeId} {
      allow read: if isSuperadmin() || activeMembership(officeId);
      allow create, delete: if isSuperadmin();
      allow update: if isSuperadmin() || (isOwner(officeId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'logo_url', 'branding_updated_at']));
    }
    match /properties/{propertyId} {
      // Everyone active in the office can see its listings.
      allow read: if signedIn() && (isSuperadmin() || (resource.data.office_id is string && activeMembership(resource.data.office_id)));
      // Agents may only create listings attributed to their own UID.
      allow create: if signedIn() && (isSuperadmin() ||
        (request.resource.data.office_id is string
          && activeMembership(request.resource.data.office_id)
          && request.resource.data.office_id == get(/databases/$(database)/documents/office_members/$(request.auth.uid)).data.office_id
          && request.resource.data.owner_agent_id == request.auth.uid));
      // Office owner can edit any listing; an agent can edit only their own and cannot transfer ownership.
      allow update: if signedIn() && (isSuperadmin() ||
        (resource.data.office_id is string
          && activeMembership(resource.data.office_id)
          && request.resource.data.office_id == resource.data.office_id
          && (isOwner(resource.data.office_id) ||
            (resource.data.owner_agent_id == request.auth.uid
              && request.resource.data.owner_agent_id == resource.data.owner_agent_id))));
      allow delete: if signedIn() && (isSuperadmin() ||
        (resource.data.office_id is string && activeMembership(resource.data.office_id)
          && (isOwner(resource.data.office_id) || resource.data.owner_agent_id == request.auth.uid)));
    }
    match /{collection}/{docId} {
      allow read: if collection != 'superadmins' && collection != 'profiles' && collection != 'office_members' && collection != 'offices' && collection != 'properties' && signedIn() && (isSuperadmin() || (resource.data.office_id is string && activeMembership(resource.data.office_id)));
      allow create: if collection != 'superadmins' && collection != 'profiles' && collection != 'office_members' && collection != 'offices' && collection != 'properties' && signedIn() && (isSuperadmin() || (request.resource.data.office_id is string && activeMembership(request.resource.data.office_id) && request.resource.data.office_id == get(/databases/$(database)/documents/office_members/$(request.auth.uid)).data.office_id));
      allow update: if collection != 'superadmins' && collection != 'profiles' && collection != 'office_members' && collection != 'offices' && collection != 'properties' && signedIn() && (isSuperadmin() || (resource.data.office_id is string && activeMembership(resource.data.office_id) && request.resource.data.office_id == resource.data.office_id));
      allow delete: if collection != 'superadmins' && collection != 'profiles' && collection != 'office_members' && collection != 'offices' && collection != 'properties' && signedIn() && (isSuperadmin() || (resource.data.office_id is string && activeMembership(resource.data.office_id) && (isOwner(resource.data.office_id) || collection == 'property_favorites' || collection == 'property_recent_views')));
    }
  }
}