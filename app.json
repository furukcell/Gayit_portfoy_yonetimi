{
  "expo": {
    "name": "GAYIT Portföy Yönetimi",
    "slug": "gayit-portfoy-yonetimi",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fkdigital.gayitportfoy"
    },
    "android": {
      "package": "com.fkdigital.gayitportfoy",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#10243A"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 340,
          "resizeMode": "contain",
          "backgroundColor": "#06172B"
        }
      ]
    ]
  }
}
